# ---------------------------------------------------------------------------
# PRIVACY: real conversation data must never be committed.
# Synthetic sample data under data/sample/ IS tracked on purpose.
# ---------------------------------------------------------------------------
data/private/
data/**/private/

# Loose WhatsApp exports, ANYWHERE in the tree. Previously only /data/*.txt was
# ignored, so an export dropped in the repo root was caught by `git add -A`.
# Default-deny with an explicit allow for the tracked synthetic set.
*.txt
!data/sample/**/*.txt
!requirements*.txt

# Reference PDFs / papers kept locally, not committed (may carry third-party PII)
*.pdf

# Databases / vector index / derived artifacts
*.db
*.sqlite
*.sqlite3
*.faiss
*.pkl
index/

# Secrets
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/

# Environments
.venv/
venv/
env/

# Model / HF caches
.cache/
models/
*.gguf

# Logs
logs/
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
