# Copy to .env and adjust. .env is git-ignored.

# --- Identity -------------------------------------------------------------
# Comma-separated list of the sender name(s) that represent YOU across your
# exports (WhatsApp labels your own messages with your profile/contact name,
# which can differ between exports). Used to resolve "I" / "me" questions.
ME_NAMES=Me

# --- Storage -----------------------------------------------------------------
DB_PATH=data/private/conversation_memory.db
INDEX_DIR=data/private/index

# --- Embeddings (increment 2) ---------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- LLM provider (increment 2) -----------------------------------------
# One of: ollama | openai | mock
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# If Ollama fails with "failed to allocate buffer", lower this to 2048 or run a
# smaller model (e.g. `ollama pull llama3.2:3b` and set OLLAMA_MODEL=llama3.2:3b).
OLLAMA_NUM_CTX=4096
LLM_MAX_TOKENS=800
LLM_TIMEOUT_S=120
# -1 = let Ollama choose GPU/CPU. Set to 0 to force CPU-only — needed if the
# CUDA runner crashes ("shared object initialization failed" / exit 0xc0000409),
# which happens when the NVIDIA driver is older than Ollama's bundled CUDA build.
OLLAMA_NUM_GPU=-1
# Used only when LLM_PROVIDER=openai (also accepts OpenAI-compatible endpoints)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Chunking ------------------------------------------------------------
CHUNK_SIZE_MESSAGES=12
CHUNK_OVERLAP_MESSAGES=3

# --- Retrieval / answering --------------------------------------------------
RETRIEVAL_TOP_K=8
# Cosine score below which the system abstains instead of calling the LLM
MIN_RETRIEVAL_SCORE=0.25

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
# When true, message text is redacted from logs (privacy-first default)
LOG_REDACT_TEXT=true
